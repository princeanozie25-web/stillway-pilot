{"arm": "plain", "bug_files": ["boltons/strutils.py"], "clean": false, "end": "DONE", "end_text": "Fixed bytes2human() to correctly switch to the next unit at exact powers of 1024. The bug was in the comparison condition: `if abs_bytes <= next_size: break` should be `if abs_bytes < next_size: break`. This ensures that values exactly at a power of 1024 (like 1024 bytes) correctly convert to the next unit (1K instead of 1024B).", "f2p_passed": 1, "f2p_total": 1, "final_hash": "34a4d6abae156334", "grade_timeout": false, "id": "boltons-4", "kind": "boundary", "model": "qwen3.5:9b-mlx", "model_s": 60.2, "outcome": "verified", "p2p_broken": 0, "p2p_broken_ids": [], "patch_ok": true, "repo": "boltons", "right_file": true, "settings": "e156e6ca5e598add", "source_changed": ["boltons/strutils.py"], "start_hash": "138d555917a427fc", "tests_changed": [], "tool_s": 0.3, "used": {"calls": 9, "dropped": 0, "prompt_tokens": 43407, "repeats": 0, "tests": 2, "tokens": 1966, "turns": 10}, "wall_s": 60.5}
