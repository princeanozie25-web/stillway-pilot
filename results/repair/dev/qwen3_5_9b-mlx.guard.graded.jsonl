{"accepted_by": "solver's done", "arm": "guard", "bug_files": ["tabulate/__init__.py"], "clean": false, "end": "DONE", "end_text": "Fixed the showindex parameter in tabulate to place the row index column on the left instead of the right. The bug was in the _prepend_row_index function which was appending the index to the end of each row instead of prepending it to the beginning. Changed `list(row) + [index_v]` to `[index_v] + list(row)`.", "f2p_passed": 6, "f2p_total": 6, "final_hash": "4c54cde32ad46aed", "grade_timeout": false, "guard": {"checks": 1, "examples": [], "probe_runs": 7, "questions": [{"agrees_with": "after", "answer": "'-  -  -\\n0  a  1\\n1  b  2\\n-  -  -'", "expr": "tabulate([['a', 1], ['b', 2]], showindex=True)", "id": "tabulate-4", "predictions": ["'-  -  -\\na  1  0\\nb  2  1\\n-  -  -'", "'-  -  -\\n0  a  1\\n1  b  2\\n-  -  -'"], "program": ["try:\n    import tabulate\n    from tabulate import *\nexcept Exception: pass\ntry: exec('from tabulate import tabulate', globals())\nexcept BaseException: pass\n", "tabulate([['a', 1], ['b', 2]], showindex=True)"], "round": 1, "setup": "from tabulate import tabulate"}, {"agrees_with": "after", "answer": "'-  -  -\\n0  a  1\\n1  b  2\\n-  -  -'", "expr": "tabulate((['a', 1], ['b', 2]), showindex=True)", "id": "tabulate-4", "predictions": ["'-  -  -\\na  1  0\\nb  2  1\\n-  -  -'", "'-  -  -\\n0  a  1\\n1  b  2\\n-  -  -'"], "program": ["try:\n    import tabulate\n    from tabulate import *\nexcept Exception: pass\ntry: exec('from tabulate import tabulate', globals())\nexcept BaseException: pass\n", "tabulate((['a', 1], ['b', 2]), showindex=True)"], "round": 2, "setup": "from tabulate import tabulate"}], "tokens": 367, "unresolved": false}, "guard_s": 13.4, "id": "tabulate-4", "kind": "wrong order", "model": "qwen3.5:9b-mlx", "model_s": 67.4, "outcome": "verified", "p2p_broken": 0, "p2p_broken_ids": [], "patch_ok": true, "repo": "tabulate", "right_file": true, "settings": "e156e6ca5e598add", "source_changed"