{"accepted_by": "solver's done", "arm": "guard", "bug_files": ["tabulate/__init__.py"], "clean": false, "end": "DONE", "end_text": "Fixed the pipe format alignment colons in tabulate. The _pipe_segment_with_colons function was generating colons on the wrong side for left/right alignment. Changed left alignment from \"-...:\" to \": -...\" and right alignment from \": -...\" to \"-...:\" to match Markdown pipe format conventions where text columns are left-aligned and numeric columns are right-aligned.", "f2p_passed": 4, "f2p_total": 4, "final_hash": "186a7bbd08a6c55d", "grade_timeout": false, "guard": {"checks": 1, "examples": [], "probe_runs": 7, "questions": [{"agrees_with": "after", "answer": "'| item   |   qty |\\n|:-------|------:|\\n| apple  |     1 |'", "expr": "tabulate([['apple', 1]], headers=['item', 'qty'], tablefmt='pipe')", "id": "tabulate-1", "predictions": ["'| item   |   qty |\\n|-------:|:------|\\n| apple  |     1 |'", "'| item   |   qty |\\n|:-------|------:|\\n| apple  |     1 |'"], "program": ["try:\n    import tabulate\n    from tabulate import *\nexcept Exception: pass\ntry: exec('from tabulate import tabulate', globals())\nexcept BaseException: pass\n", "tabulate([['apple', 1]], headers=['item', 'qty'], tablefmt='pipe')"], "round": 1, "setup": "from tabulate import tabulate"}, {"agrees_with": "after", "answer": "'| x   |   y |\\n|:----|----:|\\n| a   |   1 |'", "expr": "tabulate([['a', 1]], headers=['x', 'y'], tablefmt='pipe')", "id": "tabulate-1", "predictions": ["'| x   |   y |\\n|----:|:----|\\n| a   |   1 |'", "'| x   |   y |\\n|:----|----:|\\n| a   |   1 |'"], "program": ["try:\n    import tabulate\n    from tabulate import *\nexcept Exception: pass\ntry: exec('from tabulate import tabulate', globals())\nexcept BaseException: pass\n", "tabulate([['a', 1]], headers=['x', 'y'], tablefmt='pipe')"], "round": 2, "setup": "from tabulate import tabulate"}], "tokens": 395, "unresolved": false}, "guard_s": 14.2, "id": "tabulate-1", "kind": "swapp